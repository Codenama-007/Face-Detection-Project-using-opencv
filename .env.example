# ============================================================
# PROCTORAI — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# IMPORTANT: DO NOT PUT REAL CREDENTIALS OR SECRETS IN THIS FILE
# ============================================================

# Database Connection (PostgreSQL / Neon Cloud DB)
DATABASE_URL=postgresql://user:password@hostname:5432/dbname?sslmode=require

# Flask Session Security Key
SECRET_KEY=your_cryptographically_secure_session_secret_key_here

# Initial Platform Admin Configuration (Change upon deployment)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your_initial_admin_password_here
ADMIN_MFA_SECRET=your_base32_totp_secret_key_here

# Server Host and Port Binding
HOST=0.0.0.0
PORT=5001
